---
import personal from '../data/personal.json';

const currentYear = new Date().getFullYear();
---

<footer class="mt-8 border-t border-neutral-200 dark:border-neutral-800">
  <div class="mx-auto max-w-4xl px-6 py-10">
    <p class="max-w-2xl text-xs leading-relaxed text-neutral-600 dark:text-neutral-400">
      Content on this site is provided for informational purposes only and does not constitute professional or
      legal advice. AI-assisted material is experimental and requires human verification. See the
      <a
        href="/#governance"
        class="text-csii-ochre underline decoration-csii-gold underline-offset-4 hover:text-csii-brown dark:text-csii-gold dark:hover:text-struct-sand"
      >
        Generative AI &amp; Tooling Governance
      </a>
      statement.
    </p>

    <div class="mt-6 flex flex-col gap-4 text-xs text-neutral-600 sm:flex-row sm:items-center sm:justify-between dark:text-neutral-400">
      <p>&copy; {currentYear} {personal.fullName}. All rights reserved.</p>

      <nav aria-label="Legal">
        <ul class="flex gap-6">
          <li>
            <a href="/privacy" class="underline-offset-4 hover:text-csii-ochre hover:underline dark:hover:text-csii-gold">
              Privacy Policy
            </a>
          </li>
          <li>
            <a href="/terms" class="underline-offset-4 hover:text-csii-ochre hover:underline dark:hover:text-csii-gold">
              Terms &amp; Conditions
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</footer>
