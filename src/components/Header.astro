---
import personal from '../data/personal.json';

const links = [
  { href: '/#home', label: 'Overview' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#education', label: 'Education' },
  { href: '/#governance', label: 'AI Governance' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-40 border-b border-neutral-200 bg-csii-paper dark:border-neutral-800 dark:bg-csii-black">
  <div class="mx-auto flex max-w-4xl flex-col gap-2 px-6 py-3 sm:h-16 sm:flex-row sm:items-center sm:justify-between sm:py-0">
    <a
      href="/"
      class="font-serif text-lg font-medium tracking-tight text-csii-black dark:text-csii-paper"
      aria-label={`${personal.fullName}, home page`}
    >
      {personal.fullName}
    </a>

    <nav aria-label="Primary">
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-neutral-700 underline-offset-4 hover:text-csii-ochre hover:underline dark:text-neutral-300 dark:hover:text-csii-gold"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <button
            id="themeToggle"
            type="button"
            aria-pressed="false"
            class="border border-neutral-300 px-2 py-0.5 text-xs text-neutral-700 hover:border-csii-gold dark:border-neutral-700 dark:text-neutral-300"
          >
            Toggle theme
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>
