---
interface Props { title?: string; description?: string }

const {
  title = 'Siratee Lertsubthaworn | BAScii @ Chulalongkorn',
  description = 'Portfolio of Siratee Lertsubthaworn, a student in the Bachelor of Arts and Science in Integrated Innovation (BAScii) program at Chulalongkorn School of Integrated Innovation (CSII).',
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#EDEFEC" />
    <meta name="color-scheme" content="light dark" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=1790848665503" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet" />

    <script is:inline>
      (function () {
        var d = document.documentElement;
        var ONCE_PER_SESSION = false; // set false to show on every refresh

        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        d.setAttribute('data-theme', dark ? 'dark' : 'light');
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', dark ? '#131312' : '#EDEFEC');

        try { if ('scrollRestoration' in history) history.scrollRestoration = 'manual'; } catch (e) {}

        var skip = false;
        if (ONCE_PER_SESSION) {
          try { skip = !!sessionStorage.getItem('sl-seen'); sessionStorage.setItem('sl-seen', '1'); } catch (e) {}
        }
        if (skip) { d.classList.add('ready'); return; }

        d.classList.add('is-loading');
        var go = function () { d.classList.add('fonts-ready'); };
        var t = setTimeout(go, 1200);
        var load = document.fonts && document.fonts.load
          ? document.fonts.load('500 1em "Playfair Display"')
          : Promise.resolve();
        load.then(function () { clearTimeout(t); go(); }, function () { clearTimeout(t); go(); });
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div id="preloader" aria-hidden="true">
      <div class="pl-name">
        <span class="pl-init">S</span><span class="pl-rest"><span>iratee&nbsp;</span></span><span class="pl-init">L</span><span class="pl-rest"><span>ertsubthaworn</span></span>
      </div>
    </div>

    <div class="site-shell">
      <slot />
    </div>

    <script is:inline>
      (function () {
        var d = document.documentElement;
        var el = document.getElementById('preloader');
        if (!el) return;
        if (!d.classList.contains('is-loading')) { el.remove(); return; }

        var done = false;
        function ready() { d.classList.add('ready'); }
        function finish() {
          if (done) return;
          done = true;
          el.remove();
          ready();
          d.classList.remove('is-loading');
          if (!location.hash) window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
        }

        el.addEventListener('animationstart', function (e) { if (e.animationName === 'pl-out') ready(); });
        el.addEventListener('animationend', function (e) { if (e.animationName === 'pl-out') finish(); });
        setTimeout(finish, 4000);
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #EDEFEC;
    --text: #111111;
    --muted: #55564F;
    --accent: #8C610C;
    --gold-light: #E0B84A;
    --border: rgba(17, 17, 17, 0.16);
    --nav-bg: rgba(237, 239, 236, 0.85);
    --btn-bg: #111111;
    --btn-text: #EDEFEC;
    --btn-hover-bg: #8C610C;
    --btn-hover-text: #EDEFEC;
    --footer-bg: #111111;
    --footer-text: #EDEFEC;
    --pl-bg: var(--bg);
    --pl-fg: var(--text);
    --serif: "Playfair Display", Georgia, serif;
    --sans: "DM Sans", Arial, sans-serif;
    --mono: "DM Mono", monospace;
    --content-width: 1180px;
  }

  :root[data-theme="dark"] {
    color-scheme: dark;
    --bg: #131312;
    --text: #EDEFEC;
    --muted: #A9AAA6;
    --accent: #E0B84A;
    --border: rgba(237, 239, 236, 0.16);
    --nav-bg: rgba(19, 19, 18, 0.85);
    --btn-bg: #EDEFEC;
    --btn-text: #111111;
    --btn-hover-bg: #E0B84A;
    --btn-hover-text: #111111;
    --footer-bg: #0A0A0A;
    --pl-bg: var(--bg);
    --pl-fg: var(--text);
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { background: var(--bg); scrollbar-gutter: stable; -webkit-text-size-adjust: 100%; }
  @media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
  body {
    margin: 0; background: var(--bg); color: var(--text);
    font: 16px/1.65 var(--sans);
    -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
  }
  ::selection { background: var(--gold-light); color: #111111; }
  img, iframe { max-width: 100%; }
  a { color: inherit; }
  button, a { -webkit-tap-highlight-color: transparent; }
  [id] { scroll-margin-top: 56px; }
  .site-shell { min-height: 100svh; }
  .container { width: min(calc(100% - 48px), var(--content-width)); margin-inline: auto; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .skip-link {
    position: absolute; left: 16px; top: -56px; z-index: 10000;
    padding: 8px 14px; border-radius: 8px; text-decoration: none;
    background: var(--btn-bg); color: var(--btn-text); font: 500 0.85rem var(--sans);
  }
  .skip-link:focus { top: 12px; }

  @media (max-width: 700px) {
    .container { width: min(calc(100% - 32px), var(--content-width)); }
    body { font-size: 15px; }
  }

  /* Dynamic Preloader */
  #preloader { display: none; }
  html.is-loading { overflow: hidden; background: var(--pl-bg); }
  html.is-loading body { overflow: hidden; }
  html.is-loading #preloader {
    position: fixed; inset: 0; z-index: 9999;
    display: grid; place-items: center; padding: 0 16px;
    background: var(--pl-bg); color: var(--pl-fg);
  }

  .pl-name {
    display: flex; align-items: center; justify-content: center; white-space: nowrap;
    font: 500 clamp(1.35rem, 6vw, 4rem)/1.2 var(--serif);
    letter-spacing: 0.02em;
    opacity: 0;
  }
  #preloader .pl-init { color: var(--accent); }
  #preloader .pl-rest { color: var(--pl-fg); display: inline-grid; grid-template-columns: 0fr; }
  #preloader .pl-rest > span { min-width: 0; overflow: hidden; }

  .fonts-ready .pl-name { opacity: 1; }
  .fonts-ready #preloader { animation: pl-out 0.5s ease 1.6s forwards; }
  .fonts-ready .pl-rest { animation: pl-expand 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.35s forwards; }

  @keyframes pl-expand { to { grid-template-columns: 1fr; } }
  @keyframes pl-out { to { opacity: 0; visibility: hidden; } }

  .is-loading .reveal { opacity: 0; }
  .ready .reveal { animation: rise 0.8s ease both; }
  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fonts-ready #preloader { animation: pl-out 0.3s ease 0.7s forwards; }
    .fonts-ready .pl-rest { animation: none; grid-template-columns: 1fr; }
    .ready .reveal { animation: none; }
  }
</style>
