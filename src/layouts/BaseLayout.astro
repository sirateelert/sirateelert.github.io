---
import { ViewTransitions } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Siratee Lertsubthaworn',
  description = 'Siratee Lertsubthaworn runs finance and procurement for student-run events and hackathons at Chulalongkorn University, School of Integrated Innovation (BAScii).',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;

const aiDisclosure =
  'Generative AI tools may be used in coding, drafting and prototyping. AI-assisted outputs are experimental and require human verification; they are not professional or legal advice and carry no warranty. No confidential or non-public data is processed by third-party LLMs without strict compliance measures. See /#governance.';
const disclaimer =
  'Content is provided for informational purposes only and does not constitute professional or legal advice. See /terms and /#governance.';
---

