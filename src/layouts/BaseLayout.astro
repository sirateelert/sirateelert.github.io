---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Siratee Lertsubthaworn',
  description = 'Academic and professional profile of Siratee Lertsubthaworn, Integrated Innovation student at Chulalongkorn University.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;

const aiDisclosure =
  'Generative AI tools may be used in coding, drafting and prototyping. AI-assisted outputs are experimental and require human verification; they are not professional or legal advice and carry no warranty. No confidential or non-public data is processed by third-party LLMs without strict compliance measures. See /#governance.';
const disclaimer =
  'Content is provided for informational purposes only and does not constitute professional or legal advice. See /terms and /#governance.';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Siratee Lertsubthaworn" />
    <meta name="robots" content="index, follow" />
    <meta name="color-scheme" content="light dark" />
    <meta name="ai-disclosure" content={aiDisclosure} />
    <meta name="disclaimer" content={disclaimer} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="privacy-policy" href="/privacy" />
    <link rel="terms-of-service" href="/terms" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <!-- Apply stored theme before first paint to avoid a flash -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var dark =
            stored === 'dark' ||
            (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.classList.toggle('dark', dark);
        } catch (e) {}
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&display=swap"
    />

    {umamiId && <script defer src="https://cloud.umami.is/script.js" data-website-id={umamiId}></script>}
  </head>
  <body class="bg-csii-paper font-sans text-csii-black antialiased dark:bg-csii-black dark:text-csii-paper">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-csii-black focus:px-3 focus:py-2 focus:text-sm focus:text-csii-paper"
    >
      Skip to main content
    </a>

    <!-- SL Loader Animation -->
    <div id="sl-loader" class="fixed inset-0 z-50 flex items-center justify-center bg-csii-paper transition-opacity duration-700 dark:bg-csii-black">
      <div class="flex overflow-hidden font-serif text-4xl font-medium tracking-tight text-csii-black dark:text-csii-paper">
        <span>S</span>
        <span id="sl-iratee" class="max-w-0 opacity-0 transition-all duration-[1200ms] ease-in-out">iratee&nbsp;</span>
        <span>L</span>
        <span id="sl-ert" class="max-w-0 opacity-0 transition-all duration-[1200ms] ease-in-out">ertsubthaworn</span>
      </div>
    </div>
    <script>
      window.addEventListener('DOMContentLoaded', () => {
        const loader = document.getElementById('sl-loader');
        const iratee = document.getElementById('sl-iratee');
        const ert = document.getElementById('sl-ert');
        
        if (loader && iratee && ert) {
          setTimeout(() => {
            iratee.classList.remove('max-w-0', 'opacity-0');
            iratee.classList.add('max-w-[200px]', 'opacity-100');
            ert.classList.remove('max-w-0', 'opacity-0');
            ert.classList.add('max-w-[200px]', 'opacity-100');
          }, 300);

          setTimeout(() => {
            loader.classList.add('opacity-0');
            setTimeout(() => loader.remove(), 700);
          }, 2000);
        }
      });
    </script>

    <slot />

    <script>
      const root = document.documentElement;
      const button = document.getElementById('themeToggle');

      const sync = () => {
        if (!button) return;
        const isDark = root.classList.contains('dark');
        button.setAttribute('aria-pressed', String(isDark));
        button.textContent = isDark ? 'Light mode' : 'Dark mode';
      };

      if (button) {
        button.addEventListener('click', () => {
          const isDark = root.classList.toggle('dark');
          try {
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
          } catch (e) {}
          sync();
        });
      }

      sync();
    </script>
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
  ::selection {
    background: #e6ff50;
    color: #111111;
  }
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid #0866bf;
    outline-offset: 3px;
  }
  .dark a:focus-visible,
  .dark button:focus-visible {
    outline-color: #3ba0ff;
  }
</style>
