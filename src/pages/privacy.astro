---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Privacy Policy - Siratee Lertsubthaworn">
  <Header />
  <main class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="font-serif text-3xl font-medium mb-6 text-neutral-900 dark:text-neutral-100">Privacy Policy</h1>
    <div class="prose dark:prose-invert text-neutral-600 dark:text-neutral-400 space-y-4">
      <p>This website does not collect personal data or store cookies directly.</p>
      <p>Any interaction via external links or services is governed by their respective privacy policies.</p>
    </div>
  </main>
  <Footer />
</BaseLayout>
