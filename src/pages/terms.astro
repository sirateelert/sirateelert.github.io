---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Terms & Conditions - Siratee Lertsubthaworn">
  <Header />
  <main class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="font-serif text-3xl font-medium mb-6 text-neutral-900 dark:text-neutral-100">Terms & Conditions</h1>
    <div class="prose dark:prose-invert text-neutral-600 dark:text-neutral-400 space-y-4">
      <p>All content published on this domain is owned by Siratee Lertsubthaworn unless otherwise stated.</p>
      <p>Unauthorized redistribution or reproduction of content without written permission is prohibited.</p>
    </div>
  </main>
  <Footer />
</BaseLayout>
