---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import personal from '../data/personal.json';

const telHref = 'tel:' + personal.phone.replace(/[^\d+]/g, '');
const primaryEducation = personal.education[0];
const languages = personal.languages.map((l) => `${l.name} (${l.level})`).join('; ');

const skillGroups = [
  { label: 'Finance & Accounting', items: personal.skills.financeAndAccounting },
  { label: 'Procurement & Operations', items: personal.skills.procurementAndOperations },
  { label: 'IT & Data Tools', items: personal.skills.itAndDataTools },
];

const link =
  'text-csii-ochre underline decoration-csii-gold underline-offset-4 hover:text-csii-brown dark:text-csii-gold dark:hover:text-struct-sand';
const sectionClass = 'scroll-mt-28 border-t border-neutral-200 py-12 dark:border-neutral-800';
const gridClass = 'grid gap-6 md:grid-cols-[12rem_1fr]';
const eyebrow =
  'mb-1 block text-xs font-medium uppercase tracking-wider text-csii-ochre dark:text-csii-gold';
const h2Class = 'font-serif text-xl font-medium tracking-tight';
const muted = 'text-neutral-600 dark:text-neutral-400';
const th =
  'border-b border-neutral-300 py-2 pr-4 text-left text-xs font-medium uppercase tracking-wider text-neutral-600 dark:border-neutral-700 dark:text-neutral-400';
const td = 'border-b border-neutral-200 py-3 pr-4 align-top dark:border-neutral-800';
---

<BaseLayout title="Siratee Lertsubthaworn" description={personal.elevatorPitch}>
  <Header />

  <main id="main" class="mx-auto max-w-4xl px-6">
    <section id="home" aria-labelledby="home-heading" class="scroll-mt-28 pb-12 pt-14">
      <p class={eyebrow}>Academic &amp; Professional Profile</p>
      <h1 id="home-heading" class="font-serif text-4xl font-medium tracking-tight sm:text-5xl">
        {personal.fullName}
      </h1>
      <p class={`mt-3 text-base ${muted}`}>{personal.professionalTitle}</p>
      <p class="mt-6 max-w-2xl text-base leading-relaxed">{personal.elevatorPitch}</p>

      <dl class="mt-10 border-t border-neutral-200 text-sm dark:border-neutral-800">
        <div class="grid gap-1 border-b border-neutral-200 py-3 sm:grid-cols-[10rem_1fr] dark:border-neutral-800">
          <dt class={muted}>Affiliation</dt>
          <dd>{primaryEducation.institution}</dd>
        </div>
        <div class="grid gap-1 border-b border-neutral-200 py-3 sm:grid-cols-[10rem_1fr] dark:border-neutral-800">
          <dt class={muted}>Programme</dt>
          <dd>{primaryEducation.degree}</dd>
        </div>
        <div class="grid gap-1 border-b border-neutral-200 py-3 sm:grid-cols-[10rem_1fr] dark:border-neutral-800">
          <dt class={muted}>Period</dt>
          <dd>{primaryEducation.period}</dd>
        </div>
        {
          personal.locationVisible && (
            <div class="grid gap-1 border-b border-neutral-200 py-3 sm:grid-cols-[10rem_1fr] dark:border-neutral-800">
              <dt class={muted}>Location</dt>
              <dd>{personal.location}</dd>
            </div>
          )
        }
        <div class="grid gap-1 border-b border-neutral-200 py-3 sm:grid-cols-[10rem_1fr] dark:border-neutral-800">
          <dt class={muted}>Languages</dt>
          <dd>{languages}</dd>
        </div>
      </dl>

      <p class="mt-6 text-sm">
        <a href={personal.resumeFile} class={link}>Résumé (PDF)</a>
        <span class={muted} aria-hidden="true"> · </span>
        <a href="#contact" class={link}>Contact details</a>
      </p>
    </section>

    <section id="research" aria-labelledby="research-heading" class={sectionClass}>
      <div class={gridClass}>
        <div>
          <span class={eyebrow}>Section 1</span>
          <h2 id="research-heading" class={h2Class}>Research &amp; Professional Interests</h2>
        </div>
        <div>
          <ul class="list-disc space-y-1 pl-5 text-sm leading-relaxed">
            {personal.researchInterests.map((interest) => <li>{interest}</li>)}
          </ul>
          <p class="mt-6 max-w-2xl text-sm leading-relaxed">{personal.entrepreneurshipSummary}</p>
          <figure class="mt-8 border-l-2 border-csii-gold pl-4">
            <blockquote class="font-serif text-base italic leading-relaxed">
              <p>{personal.professionalPhilosophy}</p>
            </blockquote>
            <figcaption class={`mt-2 text-xs ${muted}`}>Professional philosophy</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section id="education" aria-labelledby="education-heading" class={sectionClass}>
      <div class={gridClass}>
        <div>
          <span class={eyebrow}>Section 2</span>
          <h2 id="education-heading" class={h2Class}>Education</h2>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[32rem] border-collapse text-sm">
            <caption class="sr-only">Formal education and exchange programmes</caption>
            <thead>
              <tr>
                <th scope="col" class={th}>Institution</th>
                <th scope="col" class={th}>Programme</th>
                <th scope="col" class={th}>Period</th>
              </tr>
            </thead>
            <tbody>
              {
                personal.education.map((entry) => (
                  <tr>
                    <th scope="row" class={`${td} text-left font-medium`}>{entry.institution}</th>
                    <td class={td}>{entry.degree}</td>
                    <td class={`${td} whitespace-nowrap`}>{entry.period}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="experience" aria-labelledby="experience-heading" class={sectionClass}>
      <div class={gridClass}>
        <div>
          <span class={eyebrow}>Section 3</span>
          <h2 id="experience-heading" class={h2Class}>Professional Experience</h2>
        </div>
        <div class="space-y-10">
          {
            personal.experience.map((job) => (
              <article>
                <h3 class="font-serif text-lg font-medium">{job.role}</h3>
                <p class={`mt-1 text-sm ${muted}`}>
                  {job.company} <span aria-hidden="true">·</span> {job.period}
                </p>
                <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed">
                  {job.bullets.map((bullet) => <li>{bullet}</li>)}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="teaching" aria-labelledby="teaching-heading" class={sectionClass}>
      <div class={gridClass}>
        <div>
          <span class={eyebrow}>Section 4</span>
          <h2 id="teaching-heading" class={h2Class}>Teaching</h2>
        </div>
        <div class="space-y-8">
          {
            personal.teachingExperience.map((item) => (
              <article>
                <h3 class="font-serif text-lg font-medium">{item.role}</h3>
                <p class={`mt-1 text-sm ${muted}`}>{item.period}</p>
                <p class="mt-3 text-sm leading-relaxed">{item.details}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="recognition" aria-labelledby="recognition-heading" class={sectionClass}>
      <div class={gridClass}>
        <div>
          <span class={eyebrow}>Section 5</span>
          <h2 id="recognition-heading" class={h2Class}>Competitions &amp; Recognition</h2>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[28rem] border-collapse text-sm">
            <caption class="sr-only">Competition results</caption>
            <thead>
              <tr>
                <th scope="col" class={th}>Competition</th>
                <th scope="col" class={th}>Result</th>
                <th scope="col" class={th}>Year</th>
              </tr>
            </thead>
            <tbody>
              {
                personal.awards.map((award) => (
                  <tr>
                    <th scope="row" class={`${td} text-left font-medium`}>{award.title}</th>
                    <td class={td}>
                      <span class="inline-block border border-accent-eco bg-accent-eco px-2 py-0.5 text-xs text-white dark:border-accent-mint">
                        {award.result}
                      </span>
                    </td>
                    <td class={`${td} whitespace-nowrap`}>{award.year}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="skills" aria-labelledby="skills-heading" class={sectionClass}>
      <div class={gridClass}>
        <div>
          <span class={eyebrow}>Section 6</span>
          <h2 id="skills-heading" class={h2Class}>Skills</h2>
        </div>
        <dl class="space-y-6">
          {
            skillGroups.map((group) => (
              <div>
                <dt class="text-xs font-medium uppercase tracking-wider text-accent-marine dark:text-accent-blue">
                  {group.label}
                </dt>
                <dd class="mt-2">
                  <ul class="flex flex-wrap gap-2 text-sm">
                    {group.items.map((item) => (
                      <li class="border border-struct-sand bg-struct-sage/40 px-2 py-0.5 dark:border-neutral-700 dark:bg-transparent">
                        {item}
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section id="governance" aria-labelledby="governance-heading" class={sectionClass}>
      <div class={gridClass}>
        <div>
          <span class={eyebrow}>Section 7</span>
          <h2 id="governance-heading" class={h2Class}>Generative AI &amp; Tooling Governance</h2>
        </div>
        <div class="max-w-2xl space-y-8 text-sm leading-relaxed">
          <p>
            This statement describes how generative artificial intelligence (AI) and large language model (LLM)
            tools are used in connection with this website and the projects presented on it. It should be read
            together with the
            <a href="/terms" class={link}>Terms &amp; Conditions</a> and the
            <a href="/privacy" class={link}>Privacy Policy</a>.
          </p>

          <div>
            <h3 class="font-serif text-lg font-medium">7.1 Experimental Nature of AI-Assisted Work</h3>
            <p class="mt-2">
              Generative AI and LLM tools may be used in coding, drafting, analysis and prototyping. Project
              outputs, prototypes and source code synthesised with these tools are experimental and are
              generated rapidly. They may contain factual errors, logical defects, security vulnerabilities or
              unresolved licensing questions. Such outputs are not presumed to be correct and are subject to
              rigorous human verification before any reliance is placed on them.
            </p>
          </div>

          <div>
            <h3 class="font-serif text-lg font-medium">7.2 Non-Reliance, No Advice and Disclaimer of Warranties</h3>
            <p class="mt-2">
              Neither AI-generated artefacts nor any other content on this site constitute professional,
              financial, engineering or legal advice, and no professional relationship is created by viewing
              or using them. All such material is provided &ldquo;as is&rdquo;, without warranties of any kind,
              express or implied, including accuracy, completeness, fitness for a particular purpose and
              non-infringement. Any artefact must be independently verified by a suitably qualified human
              reviewer before production or operational use. To the extent permitted by applicable law, the
              author accepts no liability for loss arising from reliance on such material.
            </p>
          </div>

          <div>
            <h3 class="font-serif text-lg font-medium">7.3 Professional Secrecy and Data Restrictions</h3>
            <p class="mt-2">
              No confidential, legally privileged or non-public information, including information belonging
              to employers, clients, sponsors, vendors or student organisations, is submitted to automated
              third-party LLM services unless strict compliance measures are in place. These include
              authorisation from the data owner, conformity with applicable contractual and institutional
              obligations, and compliance with applicable data protection law, including Thailand&rsquo;s
              Personal Data Protection Act B.E. 2562 (2019).
            </p>
          </div>

          <div>
            <h3 class="font-serif text-lg font-medium">7.4 Human Accountability</h3>
            <p class="mt-2">
              The author remains responsible for the accuracy of material presented under his name. AI tools
              are treated as assistive instruments, not as authorities, and their outputs are reviewed,
              tested and, where necessary, corrected or discarded.
            </p>
          </div>

          <p class={`text-xs ${muted}`}>Last reviewed: 30 September 2026.</p>
        </div>
      </div>
    </section>

    <section id="contact" aria-labelledby="contact-heading" class={sectionClass}>
      <div class={gridClass}>
        <div>
          <span class={eyebrow}>Section 8</span>
          <h2 id="contact-heading" class={h2Class}>Contact</h2>
        </div>
        <dl class="border-t border-neutral-200 text-sm dark:border-neutral-800">
          <div class="grid gap-1 border-b border-neutral-200 py-3 sm:grid-cols-[8rem_1fr] dark:border-neutral-800">
            <dt class={muted}>Email</dt>
            <dd><a href={`mailto:${personal.email}`} class={link}>{personal.email}</a></dd>
          </div>
          <div class="grid gap-1 border-b border-neutral-200 py-3 sm:grid-cols-[8rem_1fr] dark:border-neutral-800">
            <dt class={muted}>Telephone</dt>
            <dd><a href={telHref} class={link}>{personal.phone}</a></dd>
          </div>
          {
            personal.locationVisible && (
              <div class="grid gap-1 border-b border-neutral-200 py-3 sm:grid-cols-[8rem_1fr] dark:border-neutral-800">
                <dt class={muted}>Location</dt>
                <dd>{personal.location}</dd>
              </div>
            )
          }
          <div class="grid gap-1 border-b border-neutral-200 py-3 sm:grid-cols-[8rem_1fr] dark:border-neutral-800">
            <dt class={muted}>Documents</dt>
            <dd>
              <a href={personal.resumeFile} class={link}>Résumé (PDF)</a>
              <span class={muted} aria-hidden="true"> · </span>
              <a href={personal.vCardFile} class={link}>Contact card (vCard)</a>
            </dd>
          </div>
        </dl>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
