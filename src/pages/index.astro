---
import BaseLayout from '../layouts/BaseLayout.astro';
import Accordion from '../components/Accordion.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const governance = [
  {
    title: 'Intellectual Property & AI',
    body: 'I use AI as a tool, not a replacement for my own work. I review, change, test, and understand AI-assisted code before I use it. I also pay attention to licenses and third-party code when building projects.',
  },
  {
    title: 'Privacy',
    body: 'I try to treat personal data carefully from the start. If a project handles things like names, emails, or usage data, I collect only what is needed and follow applicable privacy requirements, including Thailand\'s PDPA where relevant.',
  },
  {
    title: 'Security',
    body: 'Security is part of development, not something I leave until the end. I review my projects for common vulnerabilities, exposed credentials, insecure dependencies, and unnecessary data exposure before deployment.',
  },
  {
    title: 'Responsibility',
    body: 'If I deploy something, I should understand what it does and what risks it carries. AI-generated code isn\'t automatically correct, secure, or ready for production.<br /><br />My approach is informed by established practices such as ISO/IEC 27001, ISO/IEC 42001, and the NIST AI Risk Management Framework. This is a statement of my development practices, not a claim of certification or legal compliance.',
  },
];

const contactDetails = [
  { title: 'More ways to reach me', body: `<p><strong>Mobile:</strong> +66 99 452 8880</p>` },
];
---

<BaseLayout>
  <header class="nav">
    <div class="container nav-inner">
      <a href="#" class="logo" aria-label="Siratee Lertsubthaworn, back to top">SL</a>
      <div class="nav-right">
        <nav aria-label="Primary">
          <a href="#resume">Resume</a>
          <a href="#governance"><span class="nav-long">Responsible Development</span><span class="nav-short">Responsible</span></a>
          <a href="#contact">Contact</a>
        </nav>
        <ThemeToggle />
      </div>
    </div>
  </header>

  <main id="main">
    <!-- HERO -->
    <section class="hero" id="hero">
      <div class="container">
        <div class="hero-content reveal">
          <h1>Siratee<br /><em>Lertsubthaworn</em></h1>
          <p class="hero-meta">BAScii &middot; Chulalongkorn University &middot; Class of 2029</p>
          <div class="actions">
            <a class="btn btn-primary" href="#resume">View resume</a>
            <a class="btn" href="#contact">Get in touch</a>
          </div>
        </div>
      </div>
    </section>

    <!-- RESUME -->
    <section class="section" id="resume">
      <div class="container">
        <h2>Resume</h2>
        <p class="last-updated">Last updated: Oct 2026</p>
        <a class="btn btn-primary" href="/resume.pdf" download>Download PDF</a>
        <iframe class="resume-preview" src="/resume.pdf#view=FitH" title="Resume preview" loading="lazy"></iframe>
      </div>
    </section>

    <!-- RESPONSIBLE DEVELOPMENT -->
    <section class="section section-compact" id="governance">
      <div class="container narrow">
        <h2 class="h2-sm">Responsible<br /><em>Development.</em></h2>
        <Accordion items={governance} name="gov" />
      </div>
    </section>
  </main>

  <!-- CONTACT -->
  <footer class="footer" id="contact">
    <div class="container narrow">
      <h2 class="h2-sm">Let's keep the<br /><em>conversation going.</em></h2>
      <div class="contact-primary">
        <a class="mail" href="mailto:sirateelert@gmail.com">sirateelert@gmail.com</a>
        <div class="direct-links">
          <a class="link-item" href="https://www.linkedin.com/in/sirateelertsubthaworn/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
          <a class="link-item" href="https://line.me/ti/p/9r_MXUX_H2" target="_blank" rel="noopener noreferrer">LINE ↗</a>
          <a class="link-item" href="https://wa.me/66994528880" target="_blank" rel="noopener noreferrer">WhatsApp ↗</a>
        </div>
      </div>
      <Accordion items={contactDetails} name="contact" variant="dark" />
    </div>
  </footer>
  <div id="page-end" aria-hidden="true" style="height:1px;margin-top:-1px"></div>
</BaseLayout>

<script>
  const links = Array.from(document.querySelectorAll('nav a[href^="#"]'));
  const byId = new Map(links.map((l) => [l.hash.slice(1), l]));

  const setActive = (id) =>
    byId.forEach((link, key) =>
      key === id ? link.setAttribute('aria-current', 'location') : link.removeAttribute('aria-current')
    );

  // A section is "current" while it crosses a thin band ~40% down the viewport.
  // 'hero' is observed too, so scrolling back to the top clears the highlight.
  const spy = new IntersectionObserver(
    (entries) => entries.forEach((e) => e.isIntersecting && setActive(e.target.id)),
    { rootMargin: '-40% 0px -55% 0px' }
  );
  ['hero', ...byId.keys()].forEach((id) => {
    const el = document.getElementById(id);
    if (el) spy.observe(el);
  });

  // The footer is short and may never reach the band: reaching the page end means Contact.
  const end = document.getElementById('page-end');
  if (end) new IntersectionObserver(([e]) => e.isIntersecting && setActive('contact')).observe(end);
</script>

<style>
  /* Nav */
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: var(--nav-bg);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 0; }
  .nav-right { display: flex; align-items: center; }
  .logo { font: 600 1.25rem var(--serif); text-decoration: none; color: var(--text); }
  nav a {
    margin-left: clamp(10px, 3vw, 24px);
    font: 400 0.8rem var(--mono); text-decoration: none; color: var(--text);
    transition: color 0.2s;
  }
  nav a:hover, nav a[aria-current="location"] { color: var(--accent); }
  .nav-long { display: none; }
  @media (min-width: 640px) {
    nav a { font-size: 0.85rem; }
    .nav-long { display: inline; }
    .nav-short { display: none; }
  }
  @media (max-width: 479px) { nav a { font-size: 0.75rem; margin-left: 10px; } }

  /* Hero */
  .hero { min-height: 76svh; display: flex; align-items: center; padding: 48px 0 32px; }
  .hero-content { max-width: 820px; }
  h1 { font: 500 clamp(3rem, 11vw, 6rem)/0.92 var(--serif); margin: 0 0 24px; }
  .hero-meta { margin: 0 0 32px; font: 400 0.88rem/1.5 var(--mono); color: var(--muted); letter-spacing: 0.02em; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; }

  .btn {
    display: inline-block; padding: 12px 22px;
    border: 1px solid var(--text); border-radius: 999px;
    color: var(--text); text-decoration: none; font: 500 0.9rem var(--sans);
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .btn:hover { background: var(--btn-bg); border-color: var(--btn-bg); color: var(--btn-text); }
  .btn-primary { background: var(--btn-bg); border-color: var(--btn-bg); color: var(--btn-text); }
  .btn-primary:hover { background: var(--btn-hover-bg); border-color: var(--btn-hover-bg); color: var(--btn-hover-text); }

  /* Sections */
  .section { padding: clamp(64px, 9vw, 120px) 0; border-bottom: 1px solid var(--border); }
  #resume { padding-top: clamp(48px, 6vw, 88px); }
  .section-compact { padding: clamp(48px, 6vw, 80px) 0; }
  h2 { font: 500 clamp(2rem, 5vw, 3.25rem)/1.05 var(--serif); margin: 0 0 16px; }
  .h2-sm { font-size: clamp(1.6rem, 3.5vw, 2.25rem); margin-bottom: 24px; }
  .narrow { max-width: 760px; }

  .last-updated { margin: 0 0 24px; font: 400 0.8rem var(--mono); color: var(--muted); }
  .resume-preview { display: none; width: 100%; height: 520px; margin-top: 32px; border: 1px solid var(--border); }
  @media (min-width: 900px) and (hover: hover) { .resume-preview { display: block; } }

  /* Contact (always a dark surface, so it uses the light-on-dark accent) */
  .footer {
    --accent: var(--gold-light);
    padding: clamp(56px, 7vw, 90px) 0;
    background: var(--footer-bg); color: var(--footer-text);
    border-top: 1px solid rgba(237, 239, 236, 0.08);
  }
  .contact-primary { margin-bottom: 32px; }
  .mail {
    display: inline-block; margin-bottom: 16px; overflow-wrap: anywhere;
    color: var(--accent); text-decoration: none;
    font: 500 clamp(1.2rem, 3.5vw, 1.75rem) var(--sans);
  }
  .mail:hover { text-decoration: underline; }
  .direct-links { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .link-item {
    padding: 6px 0; text-decoration: none; opacity: 0.8;
    font: 400 0.95rem var(--mono); color: var(--footer-text);
    transition: color 0.2s, opacity 0.2s;
  }
  .link-item:hover { color: var(--accent); opacity: 1; }
</style>
