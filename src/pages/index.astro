---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Siratee Lertsubthaworn">
  <Header />
  <main class="max-w-4xl mx-auto px-6 py-16">
    <section class="mb-20">
      <h1 class="font-serif text-4xl sm:text-5xl font-medium tracking-tight text-neutral-900 dark:text-neutral-100 mb-6">
        Siratee Lertsubthaworn
      </h1>
      <p class="text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl leading-relaxed">
        Integrated Innovation student at Chulalongkorn University focusing on technology entrepreneurship, business strategy, and applied operations engineering.
      </p>
    </section>
  </main>
  <Footer />
</BaseLayout>
